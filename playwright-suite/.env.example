# Single routing selector. Allowed values: dev, uat, live.
TARGET_ENV=dev

# Optional safety-checked override. It must exactly match TARGET_ENV's origin.
# Usually leave this unset; config/environments.json is the source of truth.
# BASE_URL=https://junedev.ledgers.cloud

# Identity entry URLs are fixed per environment in config/environments.json.
# The framework builds and validates each redir value from that environment's
# application origin, so DEV, UAT and LIVE cannot cross-route.
AUTH_VALIDATE_PATH=/task
AUTH_STORAGE_PATH=storage/{environment}/auth.json
AUTH_TIMEOUT_MS=60000
# Maximum time to complete visible OTP/MFA during auth:login/auth:refresh.
AUTH_MANUAL_TIMEOUT_MS=600000
# Set to 1 only when you intentionally want to replace the saved session.
AUTH_FORCE_LOGIN=0
TEST_USERNAME=
TEST_PASSWORD=

# Optional per-environment credentials. When a selected environment has either
# value, both values are required and take precedence over the shared pair.
DEV_TEST_USERNAME=
DEV_TEST_PASSWORD=
UAT_TEST_USERNAME=
UAT_TEST_PASSWORD=
LIVE_TEST_USERNAME=
LIVE_TEST_PASSWORD=

# Tools cross-user authorization identities. These must be two different
# subscribed-business members, and both must differ from the owner above.
# USER_ACCESS_TEST_USERNAME must be the same email shown in Tool Access search.
DEV_USER_ACCESS_TEST_USERNAME=
DEV_USER_ACCESS_TEST_PASSWORD=
DEV_COMPANY_ACCESS_TEST_USERNAME=
DEV_COMPANY_ACCESS_TEST_PASSWORD=
UAT_USER_ACCESS_TEST_USERNAME=
UAT_USER_ACCESS_TEST_PASSWORD=
UAT_COMPANY_ACCESS_TEST_USERNAME=
UAT_COMPANY_ACCESS_TEST_PASSWORD=
LIVE_USER_ACCESS_TEST_USERNAME=
LIVE_USER_ACCESS_TEST_PASSWORD=
LIVE_COMPANY_ACCESS_TEST_USERNAME=
LIVE_COMPANY_ACCESS_TEST_PASSWORD=

# Keep credentials only in the ignored .env file. Never put them in Excel,
# source files, recorded tests, reports, or storage session comments.

# Optional Account preflight workbook/runtime overrides. The preflight validates
# My Account, subscribed-business switching and no-subscription handling before
# a module browser project starts.
# ACCOUNT_DATA_WORKBOOK=test-data/account-data-driven.xlsx
# ACCOUNT_DATA_RUNTIME_FILE=test-results/runtime/account-data.json

# Optional Agents workbook/runtime overrides. Relative paths resolve from
# playwright-suite. Normal runs use the defaults shown here.
# AGENTS_DATA_WORKBOOK=test-data/agents-data-driven.xlsx
# AGENTS_DATA_RUNTIME_FILE=test-results/runtime/agents-data.json

# Optional Knowledge Base workbook/runtime overrides. Provider credentials and
# endpoints belong only in the ignored .env file—never in Excel, recordings,
# screenshots, reports, or source code.
# KNOWLEDGE_DATA_WORKBOOK=test-data/knowledge-data-driven.xlsx
# Usually leave KNOWLEDGE_DATA_RUNTIME_FILE unset so the framework uses its
# environment-isolated test-results/<environment>/runtime location.
# KNOWLEDGE_DATA_RUNTIME_FILE=
KNOWLEDGE_QDRANT_API_KEY=
KNOWLEDGE_QDRANT_ENDPOINT=
KNOWLEDGE_CHROMA_API_KEY=
KNOWLEDGE_CHROMA_TENANT=
KNOWLEDGE_CHROMA_DATABASE=
KNOWLEDGE_CHROMA_ALTERNATE_DATABASE=
KNOWLEDGE_CHROMA_COLLECTION=
# Reserved for supplied Weaviate credentials. The current LIVE Knowledge
# UI exposes Pinecone via OAuth, so Weaviate values are never passed to Pinecone.
KNOWLEDGE_WEAVIATE_API_KEY=
KNOWLEDGE_WEAVIATE_ENDPOINT=

# Knowledge safety gates are intentionally disabled. Enable only for approved
# synthetic test resources. LIVE requires the additional LIVE-specific gate.
KNOWLEDGE_ALLOW_WRITES=false
KNOWLEDGE_ALLOW_DELETE=false
ALLOW_LIVE_KNOWLEDGE_WRITES=0
RUN_KNOWLEDGE_PROVIDER_VERIFY=0
KNOWLEDGE_PROVIDER_CONFIG_IS_SYNTHETIC=0
ALLOW_LIVE_KNOWLEDGE_PROVIDER_VERIFY=0

# Optional Excel reporter override. By default output is isolated under
# test-results/<environment>/excel.
# EXCEL_REPORT_DIR=test-results/custom-excel

# MySQL result logging. Leave DB_HOST blank to skip logging entirely.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_WRITE_MODE=insert

PAGE_OWNER_GID=0
CREATED_BY_GID=0
