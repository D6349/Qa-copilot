# Everything here is optional. QA Copilot runs with no configuration at all.

# Where the web UI listens
PORT=4100
HOST=0.0.0.0

# Where your projects, cases and page models are stored.
# This folder IS the database — back it up by copying it.
# DATA_DIR=./data

# Where Codex prompts are written and generated suites land.
# WORKSPACE_DIR=./workspace

# Pre-fill the numeric employee GIDs on new projects (used in the MySQL rows
# that your generated Playwright suite writes).
# DEFAULT_PAGE_OWNER=
# DEFAULT_CREATED_BY=

# NOTE: there is no API key setting, and there never will be. Test cases come
# from the built-in rules engine. Anything the rules cannot derive goes through
# the Codex hand-off, which you run yourself in Cursor.
