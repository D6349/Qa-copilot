{
  "name": "qa-copilot",
  "version": "1.0.0",
  "description": "Personal QA assistant - paste a URL, get test cases, test plans and Playwright specs. No API keys.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/*.test.js",
    "browsers": "playwright install chromium",
    "seed": "node seed.js",
    "cli": "node cli.js",
    "deliver": "node cli.js deliver",
    "uiux:audit": "node ./uiux-audit/cli.mjs audit",
    "uiux:compare": "node ./uiux-audit/cli.mjs compare",
    "uiux:doctor": "node ./uiux-audit/cli.mjs doctor --pretty",
    "uiux:report:dms": "node ./uiux-audit/scripts/build-dms-comparison-report.mjs",
    "uiux:test": "npm --prefix ./uiux-audit test",
    "test:flow": "npm --prefix ./playwright-suite run test:flow",
    "test:flow:headed": "npm --prefix ./playwright-suite run test:flow:headed",
    "test:flow:write": "npm --prefix ./playwright-suite run test:flow:write",
    "test:account": "npm --prefix ./playwright-suite run test:account",
    "test:account:headed": "npm --prefix ./playwright-suite run test:account:headed",
    "test:account:excel": "npm --prefix ./playwright-suite run test:account:excel",
    "test:account:excel:headed": "npm --prefix ./playwright-suite run test:account:excel:headed",
    "test:agents": "npm --prefix ./playwright-suite run test:agents",
    "test:agents:headed": "npm --prefix ./playwright-suite run test:agents:headed",
    "test:agents:excel": "npm --prefix ./playwright-suite run test:agents:excel",
    "test:agents:excel:headed": "npm --prefix ./playwright-suite run test:agents:excel:headed",
    "test:tools": "npm --prefix ./playwright-suite run test:tools",
    "test:tools:headed": "npm --prefix ./playwright-suite run test:tools:headed",
    "test:tools:excel": "npm --prefix ./playwright-suite run test:tools:excel",
    "test:tools:excel:headed": "npm --prefix ./playwright-suite run test:tools:excel:headed",
    "test:tools:write": "npm --prefix ./playwright-suite run test:tools:write",
    "test:connectors": "npm --prefix ./playwright-suite run test:connectors",
    "test:connectors:headed": "npm --prefix ./playwright-suite run test:connectors:headed",
    "test:connectors:excel": "npm --prefix ./playwright-suite run test:connectors:excel",
    "test:connectors:excel:headed": "npm --prefix ./playwright-suite run test:connectors:excel:headed",
    "test:guardrails": "npm --prefix ./playwright-suite run test:guardrails",
    "test:guardrails:headed": "npm --prefix ./playwright-suite run test:guardrails:headed",
    "test:guardrails:excel": "npm --prefix ./playwright-suite run test:guardrails:excel",
    "test:guardrails:excel:headed": "npm --prefix ./playwright-suite run test:guardrails:excel:headed",
    "test:ui-components": "npm --prefix ./playwright-suite run test:ui-components",
    "test:ui-components:headed": "npm --prefix ./playwright-suite run test:ui-components:headed",
    "test:ui-components:excel": "npm --prefix ./playwright-suite run test:ui-components:excel",
    "test:ui-components:excel:headed": "npm --prefix ./playwright-suite run test:ui-components:excel:headed",
    "prepare:account:data": "npm --prefix ./playwright-suite run prepare:account:data",
    "prepare:agents:data": "npm --prefix ./playwright-suite run prepare:agents:data",
    "prepare:data": "npm --prefix ./playwright-suite run prepare:data",
    "data:account:init": "npm --prefix ./playwright-suite run data:account:init",
    "data:account:sync": "npm --prefix ./playwright-suite run data:account:sync",
    "data:account:reset": "npm --prefix ./playwright-suite run data:account:reset",
    "data:account:check": "npm --prefix ./playwright-suite run data:account:check",
    "data:agents:init": "npm --prefix ./playwright-suite run data:agents:init",
    "data:agents:reset": "npm --prefix ./playwright-suite run data:agents:reset",
    "data:agents:check": "npm --prefix ./playwright-suite run data:agents:check",
    "data:tools:init": "npm --prefix ./playwright-suite run data:tools:init",
    "data:tools:reset": "npm --prefix ./playwright-suite run data:tools:reset",
    "data:tools:check": "npm --prefix ./playwright-suite run data:tools:check",
    "data:connectors:init": "npm --prefix ./playwright-suite run data:connectors:init",
    "data:connectors:reset": "npm --prefix ./playwright-suite run data:connectors:reset",
    "data:connectors:check": "npm --prefix ./playwright-suite run data:connectors:check",
    "data:guardrails:init": "npm --prefix ./playwright-suite run data:guardrails:init",
    "data:guardrails:reset": "npm --prefix ./playwright-suite run data:guardrails:reset",
    "data:guardrails:check": "npm --prefix ./playwright-suite run data:guardrails:check",
    "data:ui-components:init": "npm --prefix ./playwright-suite run data:ui-components:init",
    "data:ui-components:reset": "npm --prefix ./playwright-suite run data:ui-components:reset",
    "data:ui-components:check": "npm --prefix ./playwright-suite run data:ui-components:check",
    "report:verify": "npm --prefix ./playwright-suite run report:verify",
    "report:verify:account": "npm --prefix ./playwright-suite run report:verify:account",
    "report:verify:agents": "npm --prefix ./playwright-suite run report:verify:agents",
    "report:verify:tools": "npm --prefix ./playwright-suite run report:verify:tools",
    "report:verify:connectors": "npm --prefix ./playwright-suite run report:verify:connectors",
    "report:verify:guardrails": "npm --prefix ./playwright-suite run report:verify:guardrails",
    "report:verify:ui-components": "npm --prefix ./playwright-suite run report:verify:ui-components",
    "auth:refresh": "npm --prefix ./playwright-suite run auth:refresh",
    "auth:login": "npm --prefix ./playwright-suite run auth:login",
    "record:account": "npm --prefix ./playwright-suite run record:account",
    "record:agents": "npm --prefix ./playwright-suite run record:agents",
    "record:guardrails": "npm --prefix ./playwright-suite run record:guardrails",
    "record:ui-components": "npm --prefix ./playwright-suite run record:ui-components",
    "env:run": "node ./playwright-suite/scripts/run-environment.mjs",
    "env:check": "npm --prefix ./playwright-suite run env:check",
    "test:dev": "node ./playwright-suite/scripts/run-environment.mjs dev all",
    "test:dev:headed": "node ./playwright-suite/scripts/run-environment.mjs dev all --headed",
    "test:uat": "node ./playwright-suite/scripts/run-environment.mjs uat all",
    "test:uat:headed": "node ./playwright-suite/scripts/run-environment.mjs uat all --headed",
    "test:live": "node ./playwright-suite/scripts/run-environment.mjs live all",
    "test:live:headed": "node ./playwright-suite/scripts/run-environment.mjs live all --headed",
    "auth:login:dev": "node ./playwright-suite/scripts/run-environment.mjs dev auth-login",
    "auth:login:uat": "node ./playwright-suite/scripts/run-environment.mjs uat auth-login",
    "auth:login:live": "node ./playwright-suite/scripts/run-environment.mjs live auth-login",
    "auth:refresh:dev": "node ./playwright-suite/scripts/run-environment.mjs dev auth-refresh",
    "auth:refresh:uat": "node ./playwright-suite/scripts/run-environment.mjs uat auth-refresh",
    "auth:refresh:live": "node ./playwright-suite/scripts/run-environment.mjs live auth-refresh"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "allure-commandline": "^2.46.1",
    "cheerio": "1.0.0",
    "exceljs": "4.4.0",
    "express": "4.21.2",
    "playwright": "1.49.1"
  },
  "license": "MIT",
  "devDependencies": {
    "playwright": "^1.49.1"
  },
  "bin": {
    "qa-copilot": "./cli.js"
  }
}
